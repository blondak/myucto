*.sh  text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# PHP zdroják musí mít stejné konce řádků na Windows i na Linuxu — golden
# heredocy v testech se jinak porovnávají proti CRLF verzi sebe sama.
*.php text eol=lf

# Vendorovaná XSD schémata se pinují bajt po bajtu přes api/xsd/jmhz/SHA256SUMS.
# Git je nesmí nijak konvertovat, jinak manifest sedí jen na jedné platformě.
*.xsd -text
api/xsd/jmhz/SHA256SUMS text eol=lf
