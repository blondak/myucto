{% extends '_layout.html.twig' %}
{% block content %}
<h1 style="margin:0 0 16px;font-size:22px;font-weight:600;color:#15131D;">⚡ Ranní přehled automatiky</h1>
<p style="margin:0 0 18px;">Dobrý den, dnes máte <strong>{{ totals.pending }}</strong> návrhů k potvrzení a <strong>{{ totals.needs }}</strong> položek, které potřebují váš zásah.</p>
{% for company in companies %}
<div style="padding:14px 16px;margin:10px 0;border:1px solid #D9D3EC;border-radius:8px;background:#F8F7FB;">
  <strong>{{ company.name }}</strong><br>
  <span style="color:#5A5470;">{{ company.auto }} samo · <a href="{{ company.pending_link }}">{{ company.pending }} potvrdit</a> · <a href="{{ company.needs_link }}">{{ company.needs }} potřebuje vás</a></span>
  {% if company.resweep_posted|default(0) > 0 or company.resweep_refreshed|default(0) > 0 %}<br>
  <span style="color:#5A5470;font-size:13px;">Před souhrnem jsme přepočítali návrhy, kterým chyběl předpis: {{ company.resweep_posted|default(0) }} zaúčtováno, {{ company.resweep_refreshed|default(0) }} s upřesněným důvodem.</span>
  {% endif %}
</div>
{% endfor %}
<p style="margin:22px 0 0;"><a href="{{ automation_link }}" style="display:inline-block;padding:11px 20px;background:#3B2D83;color:#fff;text-decoration:none;border-radius:8px;font-weight:600;">Otevřít Automat</a></p>
{% endblock %}
