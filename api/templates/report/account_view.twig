<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; }
    .header-period { text-align: center; font-size: 9pt; margin-top: 1mm; }
    .note { font-size: 7.5pt; color: #555; margin-bottom: 3mm; }
    table.book { width: 100%; border-collapse: collapse; margin-bottom: 2mm; }
    table.book thead th { font-size: 7pt; font-weight: normal; color: #555; text-align: right; padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.7mm 1.5mm; border-bottom: 0.2pt solid #eee; }
    .num { text-align: right; }
    .col-account { width: 20mm; }
    .col-amount { width: 30mm; }
    .group td { font-weight: bold; background-color: #f3f4f6; }
    .analytic td { color: #555; font-size: 7.5pt; }
    .subtotal td { font-weight: bold; border-top: 0.4pt solid #999; }
    .profit td { font-weight: bold; font-size: 9pt; border-top: 0.6pt solid #333; border-bottom: 0.6pt solid #333; background-color: #eef2ff; }
    .warn { color: #b91c1c; font-weight: bold; margin-top: 2mm; }
</style>
</head>
<body>
{% macro amt(v, unit) %}{% if unit == 'thousands' %}{{ (v / 1000)|round|number_format(0, ',', ' ') }}{% else %}{{ v|number_format(2, ',', ' ') }}{% endif %}{% endmacro %}
{% import _self as m %}
{% set classLabels = {'0': 'Dlouhodobý majetek', '1': 'Zásoby', '2': 'Krátkodobý finanční majetek a peněžní prostředky', '3': 'Zúčtovací vztahy', '4': 'Kapitálové účty a dlouhodobé závazky'} %}
{% set sectionLabels = {'operating': 'Provozní činnost', 'financial': 'Finanční činnost', 'unassigned': 'Účty nezařazené ve výkazu', 'tax': 'Daň z příjmů', 'transfer': 'Převod podílu na výsledku hospodaření společníkům'} %}

<table class="header-table">
    <tr>
        <td style="width:30%;"><div class="header-meta">{{ entity.name }}{% if entity.ico %}<br>IČO {{ entity.ico }}{% endif %}</div></td>
        <td style="width:40%;">
            <div class="header-title">{{ title }}</div>
            <div class="header-period">k {{ as_of|cz_date }} (fiskální rok {{ period.fiscal_year }})</div>
        </td>
        <td style="width:30%;" class="header-meta">{% if unit == 'thousands' %}v celých tisících Kč{% else %}v Kč{% endif %}</td>
    </tr>
</table>
<div class="note">Zůstatky účtů před uzavřením účetních knih (bez uzávěrkového zápisu).{% if dimension is defined and dimension and dimension.label %} Dimenze: {{ dimension.label }}.{% endif %}</div>

{% if part == 'profit_loss' %}
<table class="book">
    <thead>
        <tr><th class="thl col-account">Účet</th><th class="thl">Název</th><th class="col-amount">Náklady (MD)</th><th class="col-amount">Výnosy (D)</th></tr>
    </thead>
    <tbody>
    {% for s in profit_loss.sections %}
        {% if s.expenses is not empty or s.revenues is not empty %}
            <tr class="group"><td colspan="4">{{ sectionLabels[s.key] }}</td></tr>
            {% for acc in s.expenses|merge(s.revenues) %}
                <tr><td>{{ acc.account_code }}</td><td>{{ acc.name|slice(0, 60) }}</td>
                    <td class="num">{{ m.amt(acc.md - acc.d > 0 ? acc.md - acc.d : 0, unit) }}</td>
                    <td class="num">{{ m.amt(acc.d - acc.md > 0 ? acc.d - acc.md : 0, unit) }}</td></tr>
                {% for an in acc.analytics %}
                    <tr class="analytic"><td>&nbsp;&nbsp;{{ an.account_code }}</td><td>{{ an.name|slice(0, 60) }}</td>
                        <td class="num">{{ m.amt(an.md, unit) }}</td><td class="num">{{ m.amt(an.d, unit) }}</td></tr>
                {% endfor %}
            {% endfor %}
            <tr class="subtotal"><td colspan="2">Výsledek: {{ sectionLabels[s.key] }}</td>
                <td class="num">{{ m.amt(s.expense_total, unit) }}</td><td class="num">{{ m.amt(s.revenue_total, unit) }}</td></tr>
        {% endif %}
    {% endfor %}
    </tbody>
</table>
<table class="book">
    <tbody>
        <tr><td>Provozní výsledek hospodaření</td><td class="num col-amount">{{ m.amt(profit_loss.operating_profit, unit) }}</td></tr>
        <tr><td>Finanční výsledek hospodaření</td><td class="num col-amount">{{ m.amt(profit_loss.financial_profit, unit) }}</td></tr>
        <tr><td>Výsledek hospodaření před zdaněním</td><td class="num col-amount">{{ m.amt(profit_loss.profit_before_tax, unit) }}</td></tr>
        <tr><td>Výsledek hospodaření po zdanění</td><td class="num col-amount">{{ m.amt(profit_loss.profit_after_tax, unit) }}</td></tr>
        <tr class="profit"><td>Výsledek hospodaření za účetní období ({{ profit_loss.profit >= 0 ? 'zisk' : 'ztráta' }})</td><td class="num col-amount">{{ m.amt(profit_loss.profit, unit) }}</td></tr>
    </tbody>
</table>
{% else %}
<table class="book">
    <thead>
        <tr><th class="thl col-account">Účet</th><th class="thl">Název</th><th class="col-amount">Zůstatek MD</th><th class="col-amount">Zůstatek D</th></tr>
    </thead>
    <tbody>
    {% for c in balance.classes %}
        <tr class="group"><td colspan="4">Třída {{ c.class }} · {{ classLabels[c.class] ?? '' }}</td></tr>
        {% for acc in c.accounts %}
            <tr><td>{{ acc.account_code }}</td><td>{{ acc.name|slice(0, 60) }}</td>
                <td class="num">{{ m.amt(acc.md, unit) }}</td><td class="num">{{ m.amt(acc.d, unit) }}</td></tr>
            {% for an in acc.analytics %}
                <tr class="analytic"><td>&nbsp;&nbsp;{{ an.account_code }}</td><td>{{ an.name|slice(0, 60) }}</td>
                    <td class="num">{{ m.amt(an.md, unit) }}</td><td class="num">{{ m.amt(an.d, unit) }}</td></tr>
            {% endfor %}
        {% endfor %}
        <tr class="subtotal"><td colspan="2">Celkem třída {{ c.class }}</td>
            <td class="num">{{ m.amt(c.md, unit) }}</td><td class="num">{{ m.amt(c.d, unit) }}</td></tr>
    {% endfor %}
        <tr class="subtotal"><td colspan="2">Součet rozvahových účtů</td>
            <td class="num">{{ m.amt(balance.md, unit) }}</td><td class="num">{{ m.amt(balance.d, unit) }}</td></tr>
        <tr class="profit"><td colspan="2">Výsledek hospodaření ({{ balance.profit >= 0 ? 'zisk' : 'ztráta' }})</td>
            <td class="num" colspan="2">{{ m.amt(balance.profit, unit) }}</td></tr>
    </tbody>
</table>
{% endif %}

{% if not checks.profit_matches %}
<div class="warn">Výsledek hospodaření z rozvahových účtů ({{ m.amt(checks.profit_balance, unit) }}) se neshoduje s výsledkem z výsledkových účtů ({{ m.amt(checks.profit_loss, unit) }}).</div>
{% endif %}
</body>
</html>
