<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Přehled o peněžních tocích</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selectory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-title { font-size: 14pt; font-weight: bold; }
    .header-scope { font-size: 9pt; margin-top: 1mm; }
    .header-meta { font-size: 8pt; color: #555; margin-top: 0.5mm; }
    .entity-info { text-align: right; font-size: 9pt; }
    .section-title {
        font-size: 10pt;
        font-weight: bold;
        margin-top: 4mm;
        margin-bottom: 1mm;
        padding: 1mm 0;
        border-bottom: 0.5pt solid #999;
    }
    table.statement { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    table.statement thead th {
        font-size: 7pt;
        font-weight: normal;
        color: #555;
        text-align: right;
        padding: 1mm 1.5mm;
        border-bottom: 0.3pt solid #ccc;
        vertical-align: bottom;
    }
    table.statement thead th.thl { text-align: left; }
    table.statement tbody td {
        padding: 0.8mm 1.5mm;
        font-size: 8pt;
        border-bottom: 0.2pt solid #eee;
        vertical-align: top;
    }
    table.statement tbody tr.row-strong td {
        font-weight: bold;
        border-bottom: 0.3pt solid #ccc;
    }
    .num { text-align: right; }
    .col-code { width: 18mm; }
    .col-num { width: 30mm; }
    .checks-title { font-size: 9pt; font-weight: bold; margin-top: 4mm; margin-bottom: 1mm; }
    .check-line { font-size: 8pt; margin-top: 0.5mm; }
    .check-ok { color: #166534; }
    .check-fail { color: #b91c1c; font-weight: bold; }
    .empty-note { font-size: 8pt; color: #777; padding: 1mm 0; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:55%;">
            <div class="header-title">PŘEHLED O PENĚŽNÍCH TOCÍCH</div>
            <div class="header-scope">§ 18 odst. 2 zákona o účetnictví, § 40 až § 43 vyhl. č. 500/2002 Sb.</div>
            <div class="header-meta">za období {{ period.starts_on|cz_date }} – {{ period.ends_on|cz_date }} (v Kč)</div>
            <div class="header-meta">Okamžik sestavení: {{ entity.prepared_at }}</div>
        </td>
        <td style="width:45%;" class="entity-info">
            <strong>{{ entity.name }}</strong><br>
            IČO: {{ entity.ico }}<br>
            {{ entity.address }}
        </td>
    </tr>
</table>

<div class="section-title">SOUHRN</div>
<table class="statement">
    <tbody>
        <tr class="row-strong">
            <td>P. Počáteční stav peněžních prostředků</td>
            <td class="num col-num">{{ opening|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr>
            <td>Z. Čistý peněžní tok z provozní činnosti</td>
            <td class="num">{{ operating|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr>
            <td>A. Čistý peněžní tok z investiční činnosti</td>
            <td class="num">{{ investing|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr>
            <td>B. Čistý peněžní tok z finanční činnosti</td>
            <td class="num">{{ financing|number_format(2, ',', ' ') }}</td>
        </tr>
        {% if unclassified != 0 %}
        <tr>
            <td>N. Nezařazeno</td>
            <td class="num">{{ unclassified|number_format(2, ',', ' ') }}</td>
        </tr>
        {% endif %}
        <tr class="row-strong">
            <td>F. Čisté zvýšení / snížení peněžních prostředků</td>
            <td class="num">{{ net_change|number_format(2, ',', ' ') }}</td>
        </tr>
        <tr class="row-strong">
            <td>R. Konečný stav peněžních prostředků</td>
            <td class="num">{{ closing|number_format(2, ',', ' ') }}</td>
        </tr>
    </tbody>
</table>

{% for group, label in {
    'operating': 'PROVOZNÍ ČINNOST',
    'investing': 'INVESTIČNÍ ČINNOST',
    'financing': 'FINANČNÍ ČINNOST',
    'unclassified': 'NEZAŘAZENO'
} %}
    {% set rows = breakdown[group]|default([]) %}
    {# Prázdnou skupinu vypisujeme se slovní poznámkou, ne prázdnou tabulkou: „žádné
       pohyby" je informace, kdežto prázdná tabulka vypadá jako chyba sestavy. #}
    {% if rows is not empty or group != 'unclassified' %}
        <div class="section-title">{{ label }}</div>
        {% if rows is empty %}
            <div class="empty-note">V období nebyly zaúčtovány žádné pohyby této činnosti.</div>
        {% else %}
            <table class="statement">
                <thead>
                    <tr>
                        <th class="thl col-code">Účet</th>
                        <th class="thl">Položka</th>
                        <th class="col-num">Částka</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <td>{{ row.account_code }}</td>
                            <td>{{ row.name }}</td>
                            <td class="num">{{ row.amount|number_format(2, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    {% endif %}
{% endfor %}

<div class="checks-title">Kontrola</div>
<div class="check-line {{ reconciles ? 'check-ok' : 'check-fail' }}">
    {{ reconciles ? '✓' : '✗' }} Počáteční stav {{ opening|number_format(2, ',', ' ') }}
    + čistý tok {{ net_change|number_format(2, ',', ' ') }}
    = konečný stav {{ closing|number_format(2, ',', ' ') }}
</div>
<div class="check-line">
    Peněžní toky jsou sestaveny nepřímou metodou z pohybů na nepeněžních účtech proti účtům
    peněžních prostředků (211, 213, 221, 261); počáteční a konečný stav vychází z deníku
    bez uzávěrkových zápisů.
</div>

</body>
</html>
