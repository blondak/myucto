<table class="inputs">
    <thead>
        <tr class="group-head">
            <td colspan="6">{{ group.name }}{% if group.personal_numbers %} · {{ group.personal_numbers }}{% endif %}</td>
            <td colspan="4" class="num">{{ group.count }} vstupů</td>
        </tr>
        <tr>
            <th style="width:11%;">Osobní číslo</th>
            <th style="width:10%;">Kód složky</th>
            <th style="width:22%;">Název složky</th>
            <th class="num" style="width:7%;">Množství</th>
            <th class="num" style="width:8%;">Sazba</th>
            <th class="num" style="width:10%;">Částka Kč</th>
            <th style="width:9%;">Stav</th>
            <th style="width:10%;">Zdroj</th>
            <th style="width:13%;" colspan="2">Dávka importu</th>
        </tr>
    </thead>
    <tbody>
        {% for row in group.rows %}
            <tr>
                <td>{{ row.personal_number }}</td>
                <td>{{ row.component_code }}</td>
                <td>{{ row.component_name }}</td>
                <td class="num">{{ row.quantity }}</td>
                <td class="num">{{ row.rate }}</td>
                <td class="num">{{ row.amount }}</td>
                <td>{{ row.status }}</td>
                <td>{{ row.source }}</td>
                <td colspan="2">{{ row.import }}</td>
            </tr>
        {% endfor %}
        <tr class="group-total">
            <td colspan="5">Mezisoučet {{ group.name }}</td>
            <td class="num">{{ group.amount }}</td>
            <td colspan="4"></td>
        </tr>
    </tbody>
</table>
