<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 7.5pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 1mm; }
    .filter-table { border-collapse: collapse; margin-bottom: 3mm; }
    .filter-table td { padding: 0.4mm 2mm 0.4mm 0; font-size: 7.5pt; vertical-align: top; }
    .filter-label { color: #555; }
    table.inputs { width: 100%; border-collapse: collapse; margin-bottom: 2mm; }
    table.inputs th { font-size: 6.5pt; font-weight: normal; color: #555; text-align: left; padding: 0.8mm 1.2mm; border-bottom: 0.3pt solid #bbb; }
    table.inputs td { font-size: 7.5pt; padding: 0.6mm 1.2mm; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    table.inputs .num { text-align: right; }
    .group-head td { font-weight: bold; background-color: #f4f4f5; font-size: 8pt; }
    .group-total td { font-weight: bold; border-top: 0.3pt solid #bbb; }
    .recap-title { font-size: 10pt; font-weight: bold; margin-top: 4mm; margin-bottom: 1mm; }
    .grand-total td { font-weight: bold; font-size: 8.5pt; border-top: 0.6pt solid #555; }
    .empty { text-align: center; color: #888; padding: 8mm 0; }
</style>

<table class="header-table">
    <tr>
        <td style="width:32%;">
            <div class="header-meta">{{ entity.name }}{% if entity.ico %}, IČO: {{ entity.ico }}{% endif %}</div>
            <div class="header-meta">{{ entity.address }}</div>
        </td>
        <td style="width:36%;">
            <div class="header-title">Mzdové vstupy</div>
            <div class="header-period">období {{ period_label }}</div>
        </td>
        <td style="width:32%; text-align:right;">
            <div class="header-meta">Sestaveno: {{ exported_at }}</div>
            <div class="header-meta">{{ row_count }} vstupů, celkem {{ total }} Kč</div>
        </td>
    </tr>
</table>

<table class="filter-table">
    {% for line in filter_lines %}
        <tr><td class="filter-label">{{ line.label }}:</td><td>{{ line.value }}</td></tr>
    {% endfor %}
</table>

{% if groups is empty %}
    <p class="empty">Filtru neodpovídá žádný mzdový vstup.</p>
{% endif %}
