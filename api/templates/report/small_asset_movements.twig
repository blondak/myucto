<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Přírůstky a úbytky drobného majetku</title>
<style>
    /* mPDF kvirky: single class names, žádné nested selectory, padding v <td> ne v <div> */
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-table { width: 100%; border-collapse: collapse; margin-bottom: 4mm; }
    .header-table td { vertical-align: top; }
    .header-meta { font-size: 8pt; color: #555; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; padding: 0 6mm; }
    .header-period { text-align: center; font-size: 10pt; margin-top: 2mm; }
    .header-sub { text-align: center; font-size: 8pt; color: #555; margin-top: 1mm; }
    .group-title { font-size: 9pt; font-weight: bold; margin-top: 4mm; margin-bottom: 1mm; }
    .empty-note { font-size: 8pt; color: #888; padding: 2mm 0; }
    table.book { width: 100%; border-collapse: collapse; margin-bottom: 3mm; }
    table.book thead th {
        font-size: 7pt;
        font-weight: normal;
        color: #555;
        text-align: right;
        padding: 1mm 1.5mm;
        border-bottom: 0.3pt solid #ccc;
        vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td {
        padding: 0.8mm 1.5mm;
        font-size: 8pt;
        border-bottom: 0.2pt solid #eee;
        vertical-align: top;
    }
    table.book tfoot td {
        font-weight: bold;
        font-size: 8pt;
        padding: 1.5mm 1.5mm;
        border-top: 0.5pt solid #333;
        border-bottom: 0.5pt solid #333;
    }
    .num { text-align: right; }
    .col-date { width: 22mm; }
    .col-name { width: 62mm; }
    .col-doc { width: 30mm; }
    .col-vendor { width: 42mm; }
    .col-reason { width: 50mm; }
</style>
</head>
<body>

<table class="header-table">
    <tr>
        <td style="width:30%;">
            <div class="header-meta">{{ entity.name }}</div>
            <div class="header-meta">IČO: {{ entity.ico }}</div>
            <div class="header-meta">{{ entity.address }}</div>
        </td>
        <td style="width:40%;">
            <div class="header-title">Přírůstky a úbytky drobného majetku</div>
            <div class="header-period">{{ from|cz_date }} – {{ to|cz_date }}</div>
            <div class="header-sub">Sestaveno: {{ entity.prepared_at }}</div>
        </td>
        <td style="width:30%;"></td>
    </tr>
</table>

<div class="group-title">Přírůstky ({{ additions_count }})</div>
{% if additions is empty %}
    <div class="empty-note">Za období nebyl pořízen žádný drobný majetek.</div>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-date">Pořízeno</th>
            <th class="thl col-name">Název</th>
            <th class="thl col-doc">Doklad</th>
            <th class="thl col-vendor">Dodavatel</th>
            <th>Množství</th>
            <th>Cena bez DPH</th>
        </tr>
    </thead>
    <tbody>
        {% for row in additions %}
            <tr>
                <td>{{ row.acquisition_date|cz_date }}</td>
                <td>{{ row.name|slice(0, 60) }}</td>
                <td>{{ row.document_ref|default('—') }}</td>
                <td>{{ row.vendor_name|default('—')|slice(0, 40) }}</td>
                <td class="num">{{ row.quantity|number_format(3, ',', ' ') }}</td>
                <td class="num">{{ row.price|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="5">PŘÍRŮSTKY CELKEM</td>
            <td class="num">{{ additions_total|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

<div class="group-title">Úbytky ({{ disposals_count }})</div>
{% if disposals is empty %}
    <div class="empty-note">Za období nebyl vyřazen žádný drobný majetek.</div>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-date">Vyřazeno</th>
            <th class="thl col-name">Název</th>
            <th class="thl col-doc">Doklad</th>
            <th class="thl col-reason">Důvod vyřazení</th>
            <th>Množství</th>
            <th>Cena bez DPH</th>
        </tr>
    </thead>
    <tbody>
        {% for row in disposals %}
            <tr>
                <td>{{ row.disposed_at|cz_date }}</td>
                <td>{{ row.name|slice(0, 60) }}</td>
                <td>{{ row.document_ref|default('—') }}</td>
                <td>{{ row.disposal_reason|default('—')|slice(0, 48) }}</td>
                <td class="num">{{ row.quantity|number_format(3, ',', ' ') }}</td>
                <td class="num">{{ row.price|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="5">ÚBYTKY CELKEM</td>
            <td class="num">{{ disposals_total|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

</body>
</html>
