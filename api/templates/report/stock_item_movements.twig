<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Skladová karta</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; margin-bottom: 1mm; }
    .header-sub { text-align: center; font-size: 9pt; color: #555; margin-bottom: 3mm; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt; font-weight: normal; color: #555; text-align: right;
        padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.8mm 1.5mm; font-size: 8pt; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    .num { text-align: right; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %. */
    .col-date { width: 7%; }
    .col-doc { width: 10%; }
    .col-type { width: 7%; }
    .col-invoice { width: 11%; }
    .col-partner { width: 19%; }
    .col-wh { width: 6%; }
    .col-qty { width: 9%; }
    .col-value { width: 11%; }
</style>
</head>
<body>

<div class="header-title">Skladová karta {{ item.sku }} — {{ item.name }}</div>
<div class="header-sub">Počáteční stav: {{ movements.opening_balance|cz_money }} {{ item.unit }}</div>

{% if movements.items is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">Žádné pohyby.</p>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-date">Datum</th>
            <th class="thl col-doc">Doklad</th>
            <th class="thl col-type">Typ</th>
            <th class="thl col-invoice">Faktura</th>
            <th class="thl col-partner">Partner</th>
            <th class="thl col-wh">Sklad</th>
            <th class="col-qty">Množství</th>
            <th class="col-qty">Cena/MJ</th>
            <th class="col-value">Hodnota</th>
            <th class="col-value">Stav po pohybu</th>
        </tr>
    </thead>
    <tbody>
        {% for row in movements.items %}
            <tr>
                <td class="col-date">{{ row.doc_date|cz_date }}</td>
                <td class="col-doc">{{ row.doc_number ?: '—' }}</td>
                <td class="col-type">{{ row.doc_type }}</td>
                <td class="col-invoice">{{ row.invoice_number ?: (row.purchase_invoice_number ?: '—') }}</td>
                <td class="col-partner">{{ row.partner.name ?? '—' }}</td>
                <td class="col-wh">{{ row.warehouse_code }}</td>
                <td class="num col-qty">{{ row.qty_signed|cz_money }}</td>
                <td class="num col-qty">{{ row.unit_cost|cz_money }}</td>
                <td class="num col-value">{{ row.value_total|cz_money }}</td>
                <td class="num col-value">{{ row.balance_after|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

</body>
</html>
