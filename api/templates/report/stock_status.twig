<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="utf-8">
<title>Stav zásob</title>
<style>
    body { font-family: montserrat, dejavusans, sans-serif; font-size: 8pt; color: #15131D; }
    .header-title { font-size: 13pt; font-weight: bold; text-align: center; margin-bottom: 2mm; }
    table.book { width: 100%; border-collapse: collapse; margin: 0; } /* bez okraje: šev mezi kusy tabulky nesmí dělat mezeru */
    table.book thead th {
        font-size: 7pt; font-weight: normal; color: #555; text-align: right;
        padding: 1mm 1.5mm; border-bottom: 0.3pt solid #ccc; vertical-align: bottom;
    }
    table.book thead th.thl { text-align: left; }
    table.book tbody td { padding: 0.8mm 1.5mm; font-size: 8pt; border-bottom: 0.2pt solid #eee; vertical-align: top; }
    table.book tfoot td { font-weight: bold; font-size: 8pt; padding: 1.5mm 1.5mm; border-top: 0.5pt solid #333; }
    .num { text-align: right; }
    /* Pevné šířky všech sloupců: dlouhá sestava se sází po kusech (ChunkedHtmlWriter)
       a kusy i hlavička stránky musí lícovat, proto procenta se součtem 100 %. */
    .col-wh { width: 7%; }
    .col-sku { width: 12%; }
    .col-name { width: 35%; }
    .col-type { width: 9%; }
    .col-unit { width: 5%; }
    .col-qty { width: 11%; }
    .col-cost { width: 10%; }
    .col-value { width: 11%; }
    .below-min { color: #b91c1c; font-weight: bold; }
</style>
</head>
<body>

<div class="header-title">Stav zásob k {{ "now"|date("d.m.Y") }}</div>

{% if items is empty %}
    <p style="text-align:center; color:#888; padding: 10mm 0;">Žádné skladové zásoby neodpovídají zvoleným filtrům.</p>
{% else %}
<table class="book">
    <thead>
        <tr>
            <th class="thl col-wh">Sklad</th>
            <th class="thl col-sku">SKU</th>
            <th class="thl col-name">Název</th>
            <th class="thl col-type">Typ</th>
            <th class="thl col-unit">MJ</th>
            <th class="col-qty">Množství</th>
            <th class="col-cost">Prům. cena</th>
            <th class="col-value">Hodnota</th>
        </tr>
    </thead>
    <tbody>
        {% for row in items %}
            <tr>
                <td class="col-wh">{{ row.warehouse_code }}</td>
                <td class="col-sku">{{ row.sku }}</td>
                <td class="col-name">{{ row.name|slice(0, 55) }}</td>
                <td class="col-type">{{ row.item_type }}</td>
                <td class="col-unit">{{ row.unit }}</td>
                <td class="num col-qty {{ row.min_qty and row.qty < row.min_qty ? 'below-min' : '' }}">{{ row.qty|cz_money }}</td>
                <td class="num col-cost">{{ row.avg_unit_cost|cz_money }}</td>
                <td class="num col-value">{{ row.value_total|cz_money }}</td>
            </tr>
        {% endfor %}
    </tbody>
    <tfoot>
        <tr>
            <td colspan="7">CELKEM ({{ totals.count }} položek)</td>
            <td class="num">{{ totals.value_total|cz_money }}</td>
        </tr>
    </tfoot>
</table>
{% endif %}

</body>
</html>
